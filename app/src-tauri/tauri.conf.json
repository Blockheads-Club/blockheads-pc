{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blockheads PC",
  "version": "0.1.0",
  "identifier": "club.blockheads.pc",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blockheads PC",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "publisher": "Blockheads Club",
    "copyright": "Blockheads Club contributors. GPL-3.0-only.",
    "shortDescription": "Play The Blockheads on your computer",
    "longDescription": "Blockheads PC runs your own copy of the Android game The Blockheads on Windows, macOS and Linux. It does not contain or download the game. Unofficial fan project.",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/bhpc-run"],
    "linux": {
      "deb": { "section": "games" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
