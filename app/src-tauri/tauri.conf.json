{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blockheads PC",
  "version": "0.5.0",
  "identifier": "club.blockheads.pc",
  "build": {
    "beforeDevCommand": "node ../scripts/ensure-sidecar.mjs && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../scripts/ensure-sidecar.mjs && bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blockheads PC",
        "width": 1100,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 760,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "publisher": "Blockheads Club",
    "copyright": "Blockheads Club contributors. GPL-3.0-or-later.",
    "shortDescription": "Play The Blockheads on your computer",
    "longDescription": "Blockheads PC runs your own copy of the Android game The Blockheads on Windows, macOS and Linux. It does not contain or download the game. Unofficial fan project.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bhpc-run"
    ],
    "linux": {
      "deb": {
        "section": "games",
        "files": {
          "/usr/share/doc/blockheads-pc/copyright": "../../LICENSE",
          "/usr/share/doc/blockheads-pc/THIRD_PARTY_NOTICES.txt": "../static/third-party-notices.txt"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/doc/blockheads-pc/copyright": "../../LICENSE",
          "/usr/share/doc/blockheads-pc/THIRD_PARTY_NOTICES.txt": "../static/third-party-notices.txt"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "blockheads-pc",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEMDJGRUVCNjkwOTdCQ0UKUldUT2V3bHA2LzRDWGN4ZkJVNWJLZ0xYQXlJb2ZIdnB2bTQwb1dsZGlOODNLR1NhZkdXOVptM1QK",
      "endpoints": [
        "https://github.com/Blockheads-Club/blockheads-pc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
